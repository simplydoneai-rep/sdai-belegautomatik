# Vorlage. Kopieren nach .env (liegt im Projektordner, wird nie committet) und Werte direkt dort eintragen.
# Zugangsschlüssel nie in einen Chat kopieren.
# Solange keine Werte gesetzt sind, läuft der Machbarkeitstest nur mit dem Platzhalter-Anbieter.

# --- Amazon Bedrock (Claude, nur EU) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Alternativ zu Access Key: Bedrock-API-Schlüssel
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=eu-central-1
# Nur EU-Inferenzprofile (Präfix "eu."). Claude Fable ist ausgeschlossen.
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-5

# --- STACKIT AI Model Serving (Deutschland, OpenAI-kompatibel) ---
STACKIT_API_KEY=
STACKIT_BASE_URL=https://api.openai-compat.model-serving.eu01.onstackit.cloud/v1
# Modellnamen exakt wie in der STACKIT-Modellliste
STACKIT_MODEL_QWEN=
STACKIT_MODEL_GPTOSS=

# --- IONOS AI Model Hub (Deutschland, OpenAI-kompatibel, optional) ---
IONOS_API_KEY=
IONOS_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
IONOS_MODEL=

# --- Preise je Million Token in EUR (überschreiben backend/app/llm/preise.json) ---
# PRICE_BEDROCK_IN=
# PRICE_BEDROCK_OUT=
# PRICE_STACKIT_QWEN_IN=
# PRICE_STACKIT_QWEN_OUT=
# PRICE_STACKIT_GPTOSS_IN=
# PRICE_STACKIT_GPTOSS_OUT=
